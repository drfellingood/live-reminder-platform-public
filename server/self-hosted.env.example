# Local self-hosting works without an env file. These values show the supported overrides.
SELF_HOSTED_HOST=127.0.0.1
SELF_HOSTED_PORT=8787
SELF_HOSTED_DATA_DIR=.data
SELF_HOSTED_CONFIG=config/self-hosted.json
SELF_HOSTED_WORKER_INTERVAL_MS=1000
# Use 1 only for isolated evidence/restore inspection. It disables every mutation,
# bootstrap, scheduler, delivery worker, and credential generation.
SELF_HOSTED_READ_ONLY=0

# The default local inbox needs no external account.
DELIVERY_MODE=local-inbox

# For a generic webhook, set DELIVERY_MODE=webhook and provide an HTTPS URL.
# DELIVERY_WEBHOOK_URL=https://notifications.example.invalid/live-reminder
# DELIVERY_WEBHOOK_BEARER_TOKEN=
# DELIVERY_WEBHOOK_TIMEOUT_MS=5000
# Loopback HTTP remains blocked unless this explicit local-only opt-in is set.
# DELIVERY_WEBHOOK_ALLOW_LOOPBACK_HTTP=1

# A loopback-only first run generates these values locally and prints the
# administrator password once. Remote exposure requires all four values.
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
OBSERVATION_SECRET=
OPERATOR_SECRET=
OBSERVATION_TIME_TOLERANCE_MS=300000

ADMIN_COOKIE_SECURE=0
ADMIN_TRUST_PROXY=0

# Remote binding is blocked unless explicitly enabled. Put the service behind
# an HTTPS reverse proxy, set secure cookies, and supply all secrets first.
# SELF_HOSTED_ALLOW_REMOTE=1

# A status-source JSON entry may refer to a bearer token by environment-variable
# name, for example "bearerTokenEnvironment": "STATUS_SOURCE_PRIMARY_TOKEN".
# STATUS_SOURCE_PRIMARY_TOKEN=
