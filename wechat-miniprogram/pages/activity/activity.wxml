<view class="page-shell" aria-live="polite" aria-busy="{{viewState === 'loading'}}">
  <view class="card state-card" wx:if="{{viewState === 'loading'}}">
    <view class="spinner" aria-hidden="true"></view>
    <view class="state-title">{{t.loading}}</view>
  </view>

  <view class="card state-card" wx:elif="{{viewState === 'error' || viewState === 'unauthorized'}}">
    <view class="state-icon-well" aria-hidden="true">
      <icon type="warn" size="28" color="#0066cc" />
    </view>
    <view class="state-title">{{errorTitle}}</view>
    <view class="state-body">{{errorMessage}}</view>
    <button class="inline-button" bindtap="onRetry">{{viewState === 'unauthorized' ? t.reauthenticate : t.retry}}</button>
  </view>

  <block wx:else>
    <view class="card activity-group">
      <view class="card-header">
        <view class="card-heading">
          <view class="card-title">{{t.activitySection}}</view>
          <view class="card-description">{{t.activityHint}}</view>
        </view>
        <view class="count-pill">{{entries.length}}</view>
      </view>

      <view class="compact-empty" wx:if="{{viewState === 'empty'}}">
        <view class="state-icon-well" aria-hidden="true">
          <icon type="info" size="28" color="#0066cc" />
        </view>
        <view class="state-title">{{t.noActivityTitle}}</view>
        <view class="state-body">{{t.noActivityBody}}</view>
      </view>

      <block wx:else>
        <view class="activity-row" wx:for="{{entries}}" wx:key="id">
          <view class="icon-well activity-icon {{item.value}}" aria-hidden="true">
            <icon
              type="{{item.value === 'accepted' ? 'success' : (item.value === 'failed' ? 'cancel' : (item.value === 'pending' || item.value === 'in-flight' ? 'waiting' : 'info'))}}"
              size="20"
              color="{{item.value === 'accepted' ? '#16783b' : (item.value === 'failed' ? '#b3231a' : (item.value === 'unknown' || item.value === 'ambiguous' ? '#9b6300' : '#47647d'))}}"
            />
          </view>
          <view class="activity-copy">
            <view class="activity-heading">
              <view class="activity-channel">{{item.channelName}}</view>
              <view class="result-pill {{item.value}}">{{item.title}}</view>
            </view>
            <view class="activity-kind">{{item.kindText}}</view>
            <view class="activity-time">{{item.timestampLabel}}</view>
            <view class="activity-boundary" wx:if="{{item.kind === 'reminder'}}">{{item.handsetText}}</view>
          </view>
        </view>
      </block>
    </view>

    <view class="notice notice-row">
      <view class="icon-well" aria-hidden="true">
        <icon type="info" size="20" color="#0066cc" />
      </view>
      <view class="notice-copy">{{t.acceptedNotDisplayed}}</view>
    </view>
  </block>
</view>
