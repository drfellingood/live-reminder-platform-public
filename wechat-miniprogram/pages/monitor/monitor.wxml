<view class="page-shell" aria-live="polite" aria-busy="{{viewState === 'loading' || savingReminders || grantState === 'saving'}}">
  <view class="card state-card" wx:if="{{viewState === 'loading'}}">
    <view class="spinner" aria-hidden="true"></view>
    <view class="state-title">{{t.loading}}</view>
  </view>

  <view class="card state-card" wx:elif="{{viewState === 'error' || viewState === 'unauthorized'}}">
    <view class="state-icon-well" aria-hidden="true">
      <icon type="warn" size="28" color="#0066cc" />
    </view>
    <view class="state-title">{{errorTitle}}</view>
    <view class="state-body">{{errorMessage}}</view>
    <button class="inline-button" bindtap="onRetry">{{viewState === 'unauthorized' ? t.reauthenticate : t.retry}}</button>
  </view>

  <block wx:else>
    <image
      class="hero-art"
      src="/assets/branding/live-reminder.png"
      mode="aspectFill"
      aria-label="{{t.appName}}"
    />

    <view class="card monitor-card">
      <view class="card-header">
        <view class="card-heading">
          <view class="card-title">{{t.monitorSection}}</view>
          <view class="card-description">{{t.monitorHint}}</view>
        </view>
        <view class="count-pill">{{channels.length}}</view>
      </view>

      <view class="compact-empty" wx:if="{{viewState === 'empty'}}">
        <view class="state-icon-well" aria-hidden="true">
          <icon type="info" size="28" color="#0066cc" />
        </view>
        <view class="state-title">{{t.noMonitoredTitle}}</view>
        <view class="state-body">{{t.noMonitoredBody}}</view>
      </view>

      <block wx:else>
        <view class="channel-summary-row" wx:for="{{channels}}" wx:key="id">
          <image class="channel-avatar" src="/assets/avatars/channel.png" mode="aspectFill" aria-hidden="true" />
          <view class="channel-summary-copy">
            <view class="channel-summary-topline">
              <view class="channel-name">{{item.displayName}}</view>
              <view class="status-pill {{item.displayState}}">{{item.statusText}}</view>
            </view>
            <view class="channel-meta">{{t.sourceLabel}} · {{item.sourceLabel}}</view>
            <view class="channel-meta">{{t.updatedAt}} · {{item.updatedAtLabel}}</view>
            <view class="channel-hint">{{item.statusHint}}</view>
          </view>
        </view>
      </block>
    </view>

    <view class="notice notice-row">
      <view class="icon-well" aria-hidden="true">
        <icon type="info" size="20" color="#0066cc" />
      </view>
      <view class="notice-copy">{{t.acceptedNotDisplayed}}</view>
    </view>

    <view class="card reminder-card">
      <view class="card-header reminder-heading">
        <view class="icon-well" aria-hidden="true">
          <icon type="waiting" size="21" color="#0066cc" />
        </view>
        <view class="card-heading">
          <view class="card-title">{{t.remindersTitle}}</view>
          <view class="card-description">{{savingReminders ? t.saving : (remindersEnabled ? t.remindersOn : t.remindersOff)}}</view>
          <view class="card-description" wx:if="{{!remindersEnabled}}">{{t.remindersDisabledHint}}</view>
        </view>
        <switch
          color="#34c759"
          checked="{{remindersEnabled}}"
          disabled="{{savingReminders}}"
          bindchange="onReminderToggle"
          aria-label="{{t.remindersTitle}}"
        />
      </view>
      <view class="credit-row">
        <view class="credit-copy">
          <view class="credit-label">{{t.reminderCredits}}</view>
          <view class="credit-value">{{availableCredits}}</view>
        </view>
        <button
          class="add-button"
          disabled="{{grantState === 'saving'}}"
          bindtap="onAddReminder"
        >{{grantState === 'saving' ? t.grantInProgress : (grantState === 'pending-sync' ? t.retryGrantSync : t.addReminder)}}</button>
      </view>
    </view>

    <view class="notice warning-notice notice-row" wx:if="{{grantState === 'pending-sync'}}">
      <view class="icon-well warning" aria-hidden="true">
        <icon type="warn" size="20" color="#9b6300" />
      </view>
      <view class="notice-copy">{{t.grantSyncPending}}</view>
    </view>
  </block>
</view>
