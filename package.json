{
  "name": "live-reminder-platform",
  "version": "1.0.0",
  "description": "A vendor-neutral, self-hosted live-status reminder platform with auditable per-recipient delivery evidence.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "demo": "npm run build && node server/demo-server.cjs",
    "start": "npm run build && node --env-file-if-exists=.env server/start.cjs",
    "selfhost": "npm start",
    "admin:secrets": "node tools/generate-admin-secrets.cjs",
    "test": "node --test tests/*.test.cjs",
    "check": "npm run test && npm run build"
  },
  "dependencies": {
    "@tabler/icons-react": "^3.44.0",
    "@vitejs/plugin-react": "5.0.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.3"
  },
  "license": "AGPL-3.0-only"
}
